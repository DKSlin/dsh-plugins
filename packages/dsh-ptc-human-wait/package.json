  "description": "Pause the run_code execution deadline while a nested ask_user_question waits for the user's answer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DKSlin/dsh-plugins.git",
    "directory": "packages/dsh-ptc-human-wait"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ptc"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
