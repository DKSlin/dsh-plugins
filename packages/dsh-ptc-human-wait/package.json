{
  "name": "dsh-ptc-human-wait",
  "version": "1.0.0",
  "description": "run_code 等待用户回答时暂停执行超时（pause the PTC deadline while a nested question waits）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DKSlin/dsh-plugins.git",
    "directory": "packages/dsh-ptc-human-wait"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ptc"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "meta": {
    "title": "提问等待",
    "description": "嵌套提问等待人工回答时，不消耗 run_code 的执行超时。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
